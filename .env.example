# Docker Compose project name (used for image tags and volumes)
COMPOSE_PROJECT_NAME=jupyterhub

# Hub listens on this host port
HUB_PORT=18000

# Existing Docker network (must already exist: docker network create apps)
DOCKER_NETWORK_NAME=apps

# Admin account (auto-created on Hub start; no signup needed)
JUPYTERHUB_ADMIN=admin
JUPYTERHUB_ADMIN_PASSWORD=change-me

# Signup policy: false = new accounts need admin approval at /hub/authorize
OPEN_SIGNUP=false
# Allow public signup form (set false to disable registration entirely)
ENABLE_SIGNUP=true

# JupyterHub image version tag
JUPYTERHUB_VERSION=5.2.1

# Resource limits per user container
CPU_LIMIT=4
MEM_LIMIT=16G

# Pass host NVIDIA GPUs into user Lab containers (-1 = all GPUs)
ENABLE_GPU=true
GPU_COUNT=-1

# Idle server cull timeout in seconds
CULL_TIMEOUT=3600

# Optional: public URL when behind HTTPS reverse proxy (e.g. https://jupyter.example.com)
# PUBLIC_URL=https://jupyter.example.com

# Hostname for Traefik routing (only used with --profile proxy)
HOST=localhost

# Directory on the host containing cert.pem and key.pem for Traefik
TLS_CERTS_DIR=./reverse-proxy/certs
